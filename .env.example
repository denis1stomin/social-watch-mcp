# social-watch config. Copy to .env (git-ignored) and fill in only the platforms you set up.
# A platform with an empty value is reported as "not set up". Steps: docs/setup.md

# Threads: long-lived user token (60 days), read scopes only.
THREADS_TOKEN=<THREADS_TOKEN from https://developers.facebook.com/apps (your Threads app > Use cases > Access the Threads API), see docs/setup.md#threads>

# itch.io: API key.
ITCH_API_KEY=<ITCH_API_KEY from https://itch.io/user/settings/api-keys, see docs/setup.md#itch>

# YouTube Data API v3: API key restricted to the YouTube Data API.
YOUTUBE_API_KEY=<YOUTUBE_API_KEY from https://console.cloud.google.com/apis/credentials, see docs/setup.md#youtube>
# Your channel id (needed with the key).
YOUTUBE_CHANNEL_ID=<YOUTUBE_CHANNEL_ID, your channel id (starts with UC), see docs/setup.md#youtube>

# X: the four OAuth 1.0a keys of a separate app with Read permission only (pay-per-use credits).
X_API_KEY=<X_API_KEY (API Key) from https://developer.x.com (your read-only app > Keys and tokens), see docs/setup.md#x>
X_API_SECRET=<X_API_SECRET (API Key Secret) from the same page>
X_ACCESS_TOKEN=<X_ACCESS_TOKEN (Access Token, created with Read permissions) from the same page>
X_ACCESS_TOKEN_SECRET=<X_ACCESS_TOKEN_SECRET (Access Token Secret) from the same page>

# Optional: where `npm run snapshot` writes (default: ./stats).
# SOCIAL_WATCH_OUT_DIR=
